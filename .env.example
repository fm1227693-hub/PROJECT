# OPTIMUM ELC — Environment Configuration Template
# Duplicate this file as `.env` and provide your actual API keys

# Telegram Notification Bot Tokens
VITE_TELEGRAM_BOT_TOKEN_1=your_telegram_bot_token_1_here
VITE_TELEGRAM_BOT_TOKEN_2=your_telegram_bot_token_2_here
VITE_TELEGRAM_BOT_TOKEN_3=your_telegram_bot_token_3_here

# Firebase Realtime Database Endpoints
VITE_FIREBASE_DB_URL=https://your-project-id-default-rtdb.firebaseio.com/leads.json
VITE_FIREBASE_COMMENTS_URL=https://your-project-id-default-rtdb.firebaseio.com/comments.json
VITE_FIREBASE_SCHEDULES_URL=https://your-project-id-default-rtdb.firebaseio.com/schedules.json
VITE_FIREBASE_GROUPS_URL=https://your-project-id-default-rtdb.firebaseio.com/groups.json
